/* WAGFENCE CYBERSECURITY WEBSITE */

body {
    background-color: #111111;
    color: white;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

header {
    background-color: #58152C;
    color: #D4AF37;
    text-align: center;
    padding: 30px;
}

nav {
    background-color: #222222;
    padding: 15px;
    text-align: center;
}

nav a {
    color: #D4AF37;
    text-decoration: none;
    margin: 15px;
}

h2 {
    color: #D4AF37;
}

section {
    padding: 20px;
}

p {
    color: white;
    font-size: 18px;
    line-height: 1.6;
}

footer {
    background-color: #58152C;
    color: white;
    text-align: center;
    padding: 15px;
}
/* SERVICE CARDS */

.service-container {
    display: flex;
    gap: 25px;
    padding: 30px;
    justify-content: center;
    flex-wrap: wrap;
}

.service-card {
    background-color: #222222;
    border: 1px solid #D4AF37;
    border-radius: 10px;
    padding: 25px;
    width: 250px;
    text-align: center;
}

.service-card h3 {
    color: #D4AF37;
}

.service-card p {
    color: white;
    line-height: 1.6;
}
